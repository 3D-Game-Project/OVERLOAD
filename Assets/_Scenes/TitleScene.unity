--- !u!114 &824022392
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 824022388}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8c465140b1830c745900f2245d9b1629, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GuideUI
  _guidePages:
  - ChapterTitle: "1. \uC774\uB3D9"
    GuideGif: {fileID: 11400000, guid: 045b16b17fe31f64eb8223d655650091, type: 2}
    Description: "WASD\uB97C \uC0AC\uC6A9\uD558\uC5EC \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\nShift,
      Space Bar\uB97C \uC0AC\uC6A9\uD558\uBA74 \uB300\uC2DC, \uC810\uD504, \uBE44\uD589\uC744
      \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. "
  - ChapterTitle: "2. \uC804\uD22C"
    GuideGif: {fileID: 11400000, guid: 7942908610f2cec4d92f102b971e4d58, type: 2}
    Description: "Mouse Left\uB97C \uD1B5\uD574 \uC7A5\uCC29\uD55C \uD30C\uCE20\uC758
      \uACF5\uACA9\uC744 \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uBAAC\uC2A4\uD130\uC640\uC758
      \uC804\uD22C\uB97C \uD1B5\uD574 \uB4DC\uB78D\uB41C \uC544\uC774\uD15C\uC740
      Z\uB85C \uC8FC\uC6B8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - ChapterTitle: "3. \uC778\uBCA4\uD1A0\uB9AC"
    GuideGif: {fileID: 11400000, guid: 742faa814ee40e34d8ba5e2589a37b61, type: 2}
    Description: "E, ESC\uB97C \uC785\uB825\uD558\uC5EC \uC778\uD130\uD398\uC774\uC2A4\uB97C
      \uD65C\uC131\uD654 \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC778\uD130\uD398\uC774\uC2A4\uC5D0\uB294
      \uCE90\uB9AD\uD130 \uC815\uBCF4, \uC778\uBCA4\uD1A0\uB9AC, \uC124\uC815\uC774
      \uAC00\uB2A5\uD569\uB2C8\uB2E4."
  - ChapterTitle: "4. \uD30C\uCE20 \uC7A5\uCC29"
    GuideGif: {fileID: 11400000, guid: f177e5d0ff768ef4abbeed1fb0d2a02e, type: 2}
    Description: "\uC778\uBCA4\uD1A0\uB9AC\uC5D0 \uC874\uC7AC\uD558\uB294 \uD30C\uCE20\uB97C
      \uD074\uB9AD\uD558\uBA74 \uB2E4\uC591\uD55C \uC0C1\uD638\uC791\uC6A9\uC774
      \uAC00\uB2A5\uD569\uB2C8\uB2E4.\r\nEquip > \uC7A5\uCC29\uBD80\uC704 \uC120\uD0DD\uC744
      \uD1B5\uD574 \uD30C\uCE20 \uC7A5\uCC29 \uBC0F \uD0C8\uCC29\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
  - ChapterTitle: "5. \uC0C1\uC810"
    GuideGif: {fileID: 11400000, guid: 5480d1095d04d18439db81d2af920d5b, type: 2}
    Description: "\uC0C1\uC810 NPC\uC5D0\uAC8C \uB2E4\uAC00\uAC00\uC11C F\uB97C \uD1B5\uD574
      \uC0C1\uC810\uC5D0 \uC9C4\uC785\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC0C1\uC810\uC5D0\uB294
      \uC218\uB9AC\uD0A4\uD2B8\uC640 \uD68D\uB4DD\uD55C \uC774\uB825\uC774 \uC788\uB294
      \uD30C\uCE20\uB97C \uAD6C\uB9E4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - ChapterTitle: "6. \uAC8C\uC784 \uBAA9\uD45C"
    GuideGif: {fileID: 11400000, guid: 7942908610f2cec4d92f102b971e4d58, type: 2}
    Description: "\uCD5C\uC885 \uBCF4\uC2A4\uC640\uC758 \uC2F8\uC6C0\uC5D0\uC11C
      \uC2B9\uB9AC\uB97C \uC704\uD574 \uB2E4\uC591\uD55C \uD30C\uCE20\uB97C \uC5BB\uC5B4
      \uAC15\uD574\uC9C0\uC138\uC694!"
  _chapterTitle: {fileID: 1878538486}
  _chapterDesc: {fileID: 199517059}
  _pageIndex: {fileID: 184864708}
  _chapterImage: {fileID: 2008222102}
  _gifPlayer: {fileID: 2008222104}
